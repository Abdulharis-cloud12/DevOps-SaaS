# PipelinePulse Application
PIPELINEPULSE_ENV=development

# Collector
COLLECTOR_HOST=0.0.0.0
COLLECTOR_PORT=8000
COLLECTION_INTERVAL=30

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pipelinepulse
POSTGRES_USER=pipelinepulse
POSTGRES_PASSWORD=change_me

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000

# Jenkins
JENKINS_URL=http://localhost:8080
JENKINS_USER=your_jenkins_username
JENKINS_API_TOKEN=your_jenkins_api_token
JENKINS_JOB=pipelinepulse-sample-pipeline
